# ---- Core ----------------------------------------------------------------
TBX_ENV=production
TBX_DOMAIN=strawhatpirates-hackathon.tech
DATASET_VERSION=synthetic-v1

# ---- ClickHouse (finance source of truth) --------------------------------
CH_HOST=clickhouse
CH_PORT=8123
CH_DB=tbx_finance
CH_ADMIN_USER=tbx_admin
CH_ADMIN_PASSWORD=change-me-admin
CH_AGENT_USER=tbx_agent
CH_AGENT_PASSWORD=change-me-agent

# ---- PostgreSQL (application state) --------------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_DB=tbx_app
PG_USER=tbx
PG_PASSWORD=change-me-pg

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- MinIO (exports + Langfuse object store) -----------------------------
MINIO_ROOT_USER=tbx-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_EXPORTS=tbx-exports
MINIO_BUCKET_LANGFUSE=langfuse

# ---- Langfuse (self-hosted OSS) ------------------------------------------
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=change-me-salt
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=change-me-nextauth
LANGFUSE_PG_DB=langfuse
LANGFUSE_CH_DB=langfuse

# ---- LLM providers -------------------------------------------------------
# Primary. Small model first: escalation is measured, not assumed.
GROQ_API_KEY=
MODEL_PLANNER=groq/openai/gpt-oss-20b
MODEL_COMPOSER=groq/openai/gpt-oss-20b
MODEL_ESCALATION=groq/openai/gpt-oss-120b
# Fallback provider. FREE MODELS ONLY -- see docs/model-choice.md.
OPENROUTER_API_KEY=
MODEL_FALLBACK=openrouter/inclusionai/ling-3.0-flash-fin:free
# Optional self-hosted tier (see docs/plan-review.md section on RunPod).
RUNPOD_API_KEY=
RUNPOD_BASE_URL=
MODEL_SELFHOSTED=

# ---- Limits (defence in depth; ClickHouse enforces its own) --------------
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=20
MAX_AGENT_STEPS=12
RATE_LIMIT_PER_MINUTE=30

# ---- Cloudflare Tunnel ---------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
