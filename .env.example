# ---- Core ----------------------------------------------------------------
TBX_ENV=production
TBX_DOMAIN=strawhatpirates-hackathon.tech
DATASET_VERSION=synthetic-v1

# ---- ClickHouse (finance source of truth) --------------------------------
CH_HOST=clickhouse
CH_PORT=8123
CH_DB=tbx_finance
CH_ADMIN_USER=tbx_admin
CH_ADMIN_PASSWORD=change-me-admin
CH_AGENT_USER=tbx_agent
CH_AGENT_PASSWORD=change-me-agent

# ---- PostgreSQL (application state) --------------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_DB=tbx_app
PG_USER=tbx
PG_PASSWORD=change-me-pg

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Outside Docker (e.g. `uv run uvicorn`), use the loopback-published port:
# REDIS_URL=redis://127.0.0.1:16379/0

# ---- MinIO (exports + Langfuse object store) -----------------------------
MINIO_ROOT_USER=tbx-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_EXPORTS=tbx-exports
MINIO_BUCKET_LANGFUSE=langfuse

# ---- Langfuse (self-hosted OSS) ------------------------------------------
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=change-me-salt
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=change-me-nextauth
LANGFUSE_PG_DB=langfuse
LANGFUSE_CH_DB=langfuse

# ---- LLM providers -------------------------------------------------------
# ---- Model tiers (Section 7: 20B ceiling, smallest model first) ----------
# Every id must exist in apps/api/app/llm/catalog.py with its parameter count;
# the service refuses to start otherwise. There is NO larger-model escalation.
# Leave MODEL_PRIMARY/ALTERNATE empty to let the catalog choose (recommended).
MODEL_PRIMARY=groq/openai/gpt-oss-20b
MODEL_ALTERNATE=groq/allam-2-7b
# Cross-provider fallback for transport failures. Empty by policy: the only
# OpenRouter free models under 20B did not pass the planning probe. Set an
# id from the catalog here if you accept a paid one.
MODEL_FALLBACK=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional self-hosted tier (see docs/plan-review.md section on RunPod).
RUNPOD_API_KEY=
RUNPOD_BASE_URL=
MODEL_SELFHOSTED=

# ---- Sarvam AI (optional regional provider) -------------------------------
# Drop the key in and this tier activates automatically. sarvam-m (24B) is
# over the 20B ceiling and is excluded; sarvam-1 (2B) is provisioned but its
# chat-API id is unconfirmed. Verify before relying on it. Nothing else needs to
# change: it is gated on the key being present, and is skipped while unset.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
MODEL_REGIONAL=openai/sarvam-1
# Sarvam's OpenAI-compatible endpoint may not honour response_format; set to
# true once confirmed, otherwise the JSON extractor handles fenced output.
SARVAM_JSON_MODE=false
# Cost per 1M tokens, for the efficiency report. Fill in from their pricing.
SARVAM_INPUT_COST_PER_M=0.0
SARVAM_OUTPUT_COST_PER_M=0.0

# ---- Limits (defence in depth; ClickHouse enforces its own) --------------
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=20
MAX_AGENT_STEPS=12
RATE_LIMIT_PER_MINUTE=30

# ---- Cloudflare Tunnel ---------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
