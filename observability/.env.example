# Copy this file to .env, then replace every CHANGE_ME value with a unique secret.
# LANGFUSE_NEXTAUTH_URL must be the public URL used to reach Langfuse.

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
LANGFUSE_NEXTAUTH_URL=http://localhost:3001
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
