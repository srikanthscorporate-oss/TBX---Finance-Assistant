# Copy this file to .env, then replace every CHANGE_ME value with a unique secret.

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=tbx
MYSQL_USER=tbx
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST_BIND=0.0.0.0
MYSQL_HOST_PORT=3306
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
NGINX_PORT=80
NGINX_HTTPS_PORT=443
# Local development is open; use nginx/cloudflare-allowlist.conf on a Cloudflare VPS.
NGINX_ACCESS_POLICY=nginx/local-allowlist.conf
# Required only when starting the optional Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
# Langfuse Cloud credentials from the Langfuse project settings.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
